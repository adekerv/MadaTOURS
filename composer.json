{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "madatours/application",
  "type": "project",
  "description": "Martinique discovery application powered by Laravel, React and Supabase",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.17",
    "laravel/tinker": "^3.0"
  },
  "require-dev": {
    "driftingly/rector-laravel": "^2.6",
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.12",
    "laravel/boost": "^2.10",
    "laravel/pail": "^1.2.5",
    "laravel/pao": "^1.0.6",
    "laravel/pint": "^1.32",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^12.5.12",
    "rector/rector": "^2.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@php artisan test"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd\" \"php artisan serve --host=127.0.0.1\" \"npm run dev\" --names=laravel,vite --kill-others"
    ],
    "check": [
      "@php vendor/bin/pint --test",
      "@php artisan test"
    ],
    "vercel": [
      "@php -r \"exit(is_file('public/build/manifest.json') ? 0 : 1);\" || (npm ci --no-audit --no-fund && VITE_API_URL= npm run build:web)"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
