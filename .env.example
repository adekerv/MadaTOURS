# Development uses a local SQLite database in .data/ when DATABASE_URL is absent.
# Production requires a persistent PostgreSQL database and explicit initialization.
DATABASE_URL=
PORT=3000
# The public HTTPS origin of your hosted web app/API. Set this in production.
APP_ORIGIN=
# Explicit additional allowed origins; required for native app requests.
ALLOWED_ORIGINS=capacitor://localhost,https://localhost
# Empty for same-origin web builds. Required HTTPS API origin for native builds.
# Example shape: https://your-domain.example (without /api)
VITE_API_URL=
# Choose a bundle ID you own before creating signing profiles.
CAPACITOR_APP_ID=com.madatours.app
