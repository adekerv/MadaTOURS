APP_NAME=MadaTours
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_ORIGIN=http://127.0.0.1:8000
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Server only: never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_TIMEOUT=12
# Sign-in, sign-up and account attempts allowed per IP address in each 15-minute window.
AUTH_ATTEMPTS_PER_IP=30
# bcrypt cost (4-14) for hashing account recovery codes.
RECOVERY_CODE_COST=10
ALLOWED_ORIGINS=capacitor://localhost,https://localhost
# Trusted reverse-proxy IPs/CIDRs. Leave empty for local development.
TRUSTED_PROXIES=

# Supabase PostgreSQL direct or session-pooler URL, used by Artisan migrations/seeds.
# The running app uses the Data API with user tokens to preserve row-level security.
# DATABASE_URL remains a supported alias when DB_URL is absent.
DB_CONNECTION=pgsql
DB_URL=
DB_SSLMODE=require

# File sessions suit one server. Use Redis for multiple instances (see docs/DEPLOYMENT.md).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Welcome emails are delivered by Laravel. "log" previews messages locally without sending.
# Use "smtp" with credentials from your email provider to deliver real welcome emails.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=MadaTours

# Empty for web builds. For native builds set the deployed Laravel HTTPS origin.
VITE_API_URL=
CAPACITOR_APP_ID=com.madatours.app

# Google Maps Platform. The server key (Places API New) only matches Place IDs.
# The browser key (Maps JavaScript API + Places UI Kit) shows live Google photos,
# ratings and hours. Restrict it to your HTTP referrers; it is public by design.
GOOGLE_PLACES_API_KEY=
GOOGLE_MATCH_DAILY_LIMIT=10
VITE_GOOGLE_MAPS_API_KEY=

# Recurring maintenance (see docs/DEPLOYMENT.md). At least 32 random characters.
RECURRING_TASKS_SECRET=
RUN_SCHEDULER=true

# Optional maintenance only; the Laravel runtime does not need these credentials.
SUPABASE_ACCESS_TOKEN=
SUPABASE_SMTP_HOST=smtp-relay.brevo.com
SUPABASE_SMTP_PORT=587
SUPABASE_SMTP_USER=
SUPABASE_SMTP_PASS=
SUPABASE_SMTP_FROM_EMAIL=
SUPABASE_SMTP_SENDER_NAME=MadaTours

# OpenRouteService (https://openrouteservice.org): a free key for road routes between a tour's stops. Optional:
# without it, tours are drawn with straight lines. Never commit the real key. The service moved from
# api.openrouteservice.org to api.heigit.org/openrouteservice (the same key works); ORS_BASE_URL only needs setting
# for a self-hosted instance.
ORS_API_KEY=
