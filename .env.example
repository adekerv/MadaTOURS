# Copy to .env.local. Keep real values out of Git and chat.
# All three Supabase settings are SERVER-ONLY. Never prefix a secret with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Exact deployed HTTPS origin, with no trailing slash or path.
APP_ORIGIN=
# Exact extra web/native origins, comma-separated. No wildcard domains.
# Vercel production/deployment/branch system URLs are included automatically.
ALLOWED_ORIGINS=capacitor://localhost,https://localhost
PORT=3000
# Empty for the website; native builds require the actual HTTPS Vercel app origin.
VITE_API_URL=
CAPACITOR_APP_ID=com.madatours.app
# Optional, only for applying SQL through npm run db:apply; not needed by the running app.
DATABASE_URL=
# Optional management token for npm run auth:configure; not needed by the app or Vercel.
# Create at https://supabase.com/dashboard/account/tokens; keep it only in .env.local.
SUPABASE_ACCESS_TOKEN=
