{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)|assets/|photos/|sw\\.js$|favicon\\.svg$).*)",
      "destination": "/index.html"
    }
  ],
  "framework": "vite",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
