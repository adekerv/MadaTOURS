{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "VITE_API_URL= npm run build:web && rm -rf dist/web && mkdir -p dist/web && cp -R public/. dist/web/ && rm -f dist/web/index.php dist/web/.htaccess dist/web/hot",
  "outputDirectory": "dist/web",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.php"
    }
  ],
  "headers": [
    {
      "source": "/build/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/internal/tasks",
      "schedule": "15 10 * * *"
    }
  ]
}
