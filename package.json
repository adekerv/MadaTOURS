{
  "name": "madatours",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run typecheck",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "admin:grant": "php artisan admin:grant",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mobile:assets": "node --import tsx scripts/generate-native-assets.ts",
    "db:prepare": "php artisan db:export-setup",
    "db:apply": "php artisan migrate --seed",
    "pretest": "npm run db:prepare",
    "pretest:e2e": "npm run db:prepare",
    "setup:check": "php artisan supabase:check",
    "test:live": "node --import tsx scripts/smoke-supabase.ts",
    "catalogue:import": "node --import tsx scripts/import-catalogue.ts",
    "auth:configure": "node --import tsx scripts/configure-auth-email.ts",
    "serve": "php artisan serve --host=127.0.0.1",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "test:php": "php artisan test",
    "check": "composer check && npm run lint && npm test && npm run build && npm run format:check",
    "auth:signup": "node --import tsx scripts/configure-signup.ts",
    "admin:create": "php artisan admin:create",
    "catalogue:sync-seed": "node --import tsx scripts/sync-seed.ts",
    "places:apply": "node --import tsx scripts/apply-listing.ts",
    "sources:apply": "node --import tsx scripts/apply-sources.ts",
    "places:audit": "node --import tsx scripts/audit-places.ts",
    "sources:extract": "node --import tsx scripts/extract-sources.ts",
    "coastline:build": "node --import tsx scripts/build-coastline.ts",
    "store:assets": "node --import tsx scripts/generate-share-assets.ts",
    "store:screenshots": "node --import tsx scripts/capture-store-screenshots.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@fontsource/outfit": "^5.2.0",
    "@fontsource/playfair-display": "^5.2.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-leaflet": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.0.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@supabase/supabase-js": "2.117.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "cheerio": "^1.2.0",
    "concurrently": "^9.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "laravel-vite-plugin": "^3.1.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
